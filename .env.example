# ---------------------------------------------------------------------------
# Gardien environment configuration (copy to .env and adjust per environment)
# ---------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Used by Prisma (apps/api) and the docker-compose postgres service.
POSTGRES_USER=gardien
POSTGRES_PASSWORD=gardien_dev_password
POSTGRES_DB=gardien
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gardien:gardien_dev_password@localhost:5432/gardien?schema=public

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# Comma-separated list of origins allowed to call the API (the web app dev server).
CORS_ORIGIN=http://localhost:5173
# IMPORTANT: generate a strong secret for production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
# Bootstrap single-user account created by the seed script.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# --- Web ------------------------------------------------------------------
# Base URL the PWA uses to reach the API.
VITE_API_BASE_URL=http://localhost:3000

# --- Backups --------------------------------------------------------------
# Cron schedule + retention for automated pg_dump backups (docker compose).
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=14
