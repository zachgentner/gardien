// Gardien core data model (Phase 0).
//
// Cross-cutting principles baked in at the schema level:
//   * Explicit units   — physical quantities stored in canonical metric
//                        (lengths in millimetres, areas in m^2); the user's
//                        preferred display system lives on `User.unitSystem`.
//   * Soft deletes     — every user-facing entity has `deletedAt`; archiving a
//                        bed/garden/season never destroys its history.
//   * Seasons first-class — `Season` is its own table; plantings & amendments
//                        are scoped to a season.
//   * Multi-user ready — user-owned rows carry `ownerId`; the plant directory
//                        is global (ownerId null) but allows per-user entries
//                        later, so Phase 8 multi-tenancy is not a retrofit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & auth
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  member
}

enum UnitSystem {
  metric
  imperial
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String?
  role         UserRole   @default(owner)
  unitSystem   UnitSystem @default(imperial)

  // Location & hardiness zone (Phase 1). The zone drives planting windows and
  // suitability. Derived from ZIP, but always overridable (microclimates).
  zipCode       String?
  hardinessZone String?
  // True when the user set the zone by hand rather than from a ZIP lookup, so
  // a later ZIP change doesn't silently clobber their override.
  zoneIsManual  Boolean @default(false)
  latitude      Float?
  longitude     Float?

  gardens   Garden[]
  seasons   Season[]
  plants    Plant[]
  families  PlantFamily[]
  devices   Device[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Plant knowledge base (global by default; ownerId set for custom entries)
// ---------------------------------------------------------------------------

enum PlantType {
  vegetable
  fruit
  herb
  flower
  cover_crop
}

enum SunRequirement {
  full_sun
  partial_sun
  partial_shade
  full_shade
}

enum WaterRequirement {
  low
  medium
  high
}

enum FeederType {
  heavy
  medium
  light
  fixer
}

enum CompanionRelation {
  companion
  antagonist
}

model PlantFamily {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  // Rotation operates at the family level; same group => don't follow itself.
  rotationGroup String?
  source      String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  plants Plant[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model Plant {
  id             String           @id @default(cuid())
  commonName     String
  scientificName String?
  slug           String           @unique
  type           PlantType
  sun            SunRequirement?
  water          WaterRequirement?
  feederType     FeederType?

  // Explicit units: spacing stored in millimetres.
  spacingMm        Int?
  rowSpacingMm     Int?
  daysToMaturityMin Int?
  daysToMaturityMax Int?

  soilNotes      String?
  growingTips    String?
  commonMistakes String?
  // Source / attribution so a reader can judge reliability.
  source         String?

  familyId String?
  family   PlantFamily? @relation(fields: [familyId], references: [id])

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  // Companion relationships (directional rows; seed both directions).
  companionsFrom CompanionLink[] @relation("CompanionFrom")
  companionsTo   CompanionLink[] @relation("CompanionTo")

  windows PlantingWindow[]
  issues  PlantIssue[]

  plantings PlantingRecord[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([familyId])
  @@index([deletedAt])
}

enum PlantIssueKind {
  pest
  disease
}

/// A pest or disease commonly affecting a plant (Phase 2 knowledge base).
model PlantIssue {
  id          String         @id @default(cuid())
  kind        PlantIssueKind
  name        String
  description String?
  management  String?
  source      String?

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  // Custom user entry when set; null = curated/global.
  ownerId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([plantId])
  @@index([deletedAt])
}

/// Planting & harvest windows for a plant in a given USDA zone, as month
/// ranges (1-12, inclusive, wrap-around allowed e.g. Nov->Feb). Overridable:
/// a row with `ownerId` set is the user's override of the curated window
/// (ownerId null) for that plant+zone.
model PlantingWindow {
  id   String @id @default(cuid())
  zone String

  plantStartMonth Int
  plantEndMonth   Int
  harvestStartMonth Int?
  harvestEndMonth   Int?

  source String?
  notes  String?

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  ownerId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([plantId, zone, ownerId])
  @@index([plantId])
  @@index([zone])
  @@index([deletedAt])
}

model CompanionLink {
  id       String            @id @default(cuid())
  plantAId String
  plantBId String
  relation CompanionRelation
  reason   String?
  source   String?

  plantA Plant @relation("CompanionFrom", fields: [plantAId], references: [id], onDelete: Cascade)
  plantB Plant @relation("CompanionTo", fields: [plantBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([plantAId, plantBId, relation])
  @@index([plantAId])
  @@index([plantBId])
}

// ---------------------------------------------------------------------------
// Physical spaces
// ---------------------------------------------------------------------------

enum BedType {
  raised_bed
  in_ground
  container
  greenhouse
}

model Garden {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Stored for later weather/frost features (Phase 1+).
  latitude     Float?
  longitude    Float?
  hardinessZone String? // user override allowed

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  beds Bed[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // archive

  @@index([ownerId])
  @@index([deletedAt])
}

model Bed {
  id       String  @id @default(cuid())
  name     String
  bedType  BedType @default(raised_bed)
  location String?
  soilType String?

  // Explicit units: dimensions in millimetres, area in square metres.
  lengthMm Int?
  widthMm  Int?
  areaSqM  Float?

  gardenId String
  garden   Garden @relation(fields: [gardenId], references: [id])

  plantings  PlantingRecord[]
  amendments SoilAmendment[]
  devices    Device[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // archive

  @@index([gardenId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Seasons (first-class) & history
// ---------------------------------------------------------------------------

enum SeasonType {
  spring
  summer
  fall
  winter
}

model Season {
  id        String     @id @default(cuid())
  name      String
  seasonType SeasonType
  year      Int
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean    @default(false)
  notes     String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  plantings  PlantingRecord[]
  amendments SoilAmendment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([year])
  @@index([deletedAt])
}

enum PlantingStatus {
  planned
  planted
  harvested
  removed
}

model PlantingRecord {
  id       String         @id @default(cuid())
  quantity Int            @default(1)
  status   PlantingStatus @default(planned)

  // Plan vs. actual: planned dates vs. the dates things really happened.
  plannedPlantDate   DateTime?
  plannedHarvestDate DateTime?
  plantedOn          DateTime?
  harvestedOn        DateTime?

  notes String?

  bedId    String
  bed      Bed    @relation(fields: [bedId], references: [id])
  plantId  String
  plant    Plant  @relation(fields: [plantId], references: [id])
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([bedId])
  @@index([plantId])
  @@index([seasonId])
  @@index([deletedAt])
}

model SoilAmendment {
  id        String   @id @default(cuid())
  name      String
  appliedOn DateTime @default(now())

  // Explicit units: free amount + unit string (e.g. 2 "kg", 1 "cu_ft").
  amount     Float?
  amountUnit String?
  notes      String?

  bedId    String
  bed      Bed     @relation(fields: [bedId], references: [id])
  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([bedId])
  @@index([seasonId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Location & hardiness zone (Phase 1)
// ---------------------------------------------------------------------------

/// Cached ZIP -> USDA hardiness zone lookups. Lets us avoid re-hitting the
/// external zone API and keep serving results when it is unavailable
/// (graceful degradation). `fetchedAt` drives optional freshness checks.
model ZoneLookupCache {
  zip           String   @id
  hardinessZone String
  latitude      Float?
  longitude     Float?
  temperatureRange String?
  source        String   @default("phzmapi")
  fetchedAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Weather-driven alerts (Phase 6)
// ---------------------------------------------------------------------------

/// Cached localized forecasts keyed by rounded "lat,lon", so we avoid re-hitting
/// the weather API and keep serving (stale) forecasts when it is unavailable
/// (graceful degradation). `days` holds the parsed daily forecast as JSON.
model WeatherCache {
  key       String   @id
  latitude  Float
  longitude Float
  days      Json
  source    String   @default("open-meteo")
  fetchedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Hardware / IoT (Phase 7)
// ---------------------------------------------------------------------------

enum SensorMetric {
  air_temp
  humidity
  soil_moisture
  water_level
  light
}

/// An ESP32 (or similar) controller that reports sensor readings and may drive
/// irrigation for a bed. Authenticates with a per-device token (only its hash
/// is stored, like a password) so devices never share a key.
model Device {
  id        String  @id @default(cuid())
  name      String
  tokenHash String

  // Optional bed this device monitors / irrigates.
  bedId String?
  bed   Bed?    @relation(fields: [bedId], references: [id])

  // Health / calibration tracking.
  batteryPct      Float?
  firmwareVersion String?
  lastSeenAt      DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  readings SensorReading[]
  config   IrrigationConfig?
  runs     IrrigationRun[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([bedId])
  @@index([deletedAt])
}

/// A single sensor sample. `recordedAt` is when the device measured it (which
/// may be earlier than receipt, since devices buffer offline and sync later);
/// the unique key makes re-syncing buffered readings idempotent.
model SensorReading {
  id         String       @id @default(cuid())
  metric     SensorMetric
  value      Float
  unit       String
  recordedAt DateTime
  createdAt  DateTime     @default(now())

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, metric, recordedAt])
  @@index([deviceId, metric, recordedAt])
}

/// Per-device automatic-irrigation policy. All durations in milliseconds. The
/// fail-safe rules in `domain/irrigation.ts` consume these.
model IrrigationConfig {
  id             String  @id @default(cuid())
  deviceId       String  @unique
  device         Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  enabled        Boolean @default(false)
  thresholdPct   Float   @default(30)
  requestedRunMs Int     @default(120000) // 2 min
  maxRunMs       Int     @default(300000) // 5 min — hard cap
  minIntervalMs  Int     @default(21600000) // 6 h — anti-flood
  staleAfterMs   Int     @default(7200000) // 2 h — older readings are untrusted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A logged irrigation run (or decision), so the anti-flood interval has a real
/// `lastRunEndedAt` and runs are auditable.
model IrrigationRun {
  id              String   @id @default(cuid())
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  startedAt       DateTime @default(now())
  endedAt         DateTime
  runMs           Int
  reason          String
  soilMoisturePct Float?
  createdAt       DateTime @default(now())

  @@index([deviceId, startedAt])
}
